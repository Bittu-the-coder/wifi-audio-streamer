# ── WiFi Audio Stream — all options (copy what you need into .env) ─────────

# Where the server finds ffmpeg. Point at the bundled copy inside the project.
FFMPEG_PATH=tools/ffmpeg/ffmpeg.exe

# Capture device name (see: pnpm list:devices).
#   VB-Cable (laptop silent, phones only):  CABLE Output (VB-Audio Virtual Cable)
#   Laptop speakers + phones at once:        Stereo Mix   (enable it in Windows
#                                             Sound > Recording > Show Disabled Devices)
CAPTURE_DEVICE=CABLE Output (VB-Audio Virtual Cable)

# Port the server listens on, and what LAN IP it shows in the URL/QR.
# (LAN_IP only needed if auto-detection picks the wrong adapter.)
PORT=8080
# HOST=0.0.0.0
# LAN_IP=

# Mode: auto (ffmpeg if found, else test tone) | static (test tone only) | ffmpeg
MODE=auto

# ── Sync / latency ─────────────────────────────────────────────────────────
# "Sync start" countdown before all phones restart from position 0 together.
SYNC_LEAD_MS=2500
# Segment length in ms (smaller = snappier, larger = more stable).
SEGMENT_MS=1000
# Segments behind live that normal joins start at (0 = lowest delay, more
# stutter risk; 1 default; 2 = smoother).
LIVE_EDGE=1

# ── Audio quality / capture ────────────────────────────────────────────────
AUDIO_BITRATE=128k
AUDIO_BUFFER_MS=100
# Server-side gain for live capture (0.05–2, 1 = normal). Only applies in
# ffmpeg mode. Phone volume is per-device on the page.
# VOLUME=1

# ── Security (optional) ────────────────────────────────────────────────────
# Set a shared PIN to keep other people on the same WiFi from listening.
# Phones must enter it once per session.
# AUTH_PIN=1234
